{
  "name": "nexgen-ems",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "cd packages/db && npx prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.15.0",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "prettier": "^3.3.3",
    "turbo": "^2.9.18",
    "typescript": "^5.6.3",
    "ws": "8.21.0"
  },
  "overrides": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "multer": "2.2.0",
    "uuid": "11.1.1",
    "ws": "8.21.0",
    "engine.io": {
      "ws": "8.21.0"
    },
    "engine.io-client": {
      "ws": "8.21.0"
    },
    "socket.io-adapter": {
      "ws": "8.21.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.11.0"
}
