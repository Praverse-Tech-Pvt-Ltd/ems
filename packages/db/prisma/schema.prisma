generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  WFH
  LEAVE
  HOLIDAY
  MISSING_PUNCH_OUT
}

enum ExpenseCategory {
  TRAVEL
  FOOD
  OFFICE
  CLIENT_VISIT
  HOTEL
  STATIONERY
  MISC
}

enum PaymentMode {
  CASH
  CARD
  UPI
  BANK_TRANSFER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  L1_REVIEW
  FINANCE_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum InvoiceType {
  VENDOR
  CLIENT
}

enum InvoiceStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  OVERDUE
}

enum LeaveType {
  CL
  SL
  PL
  UL
  CO
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestType {
  WFH
  ADVANCE_PAYMENT
  DOCUMENT_REQUEST
  ASSET_REQUEST
  TRAVEL_APPROVAL
  ATTENDANCE_CORRECTION
  OTHER
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  PUNCH_IN
  PUNCH_OUT
  MISSING_PUNCH_OUT
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_PAID
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  INVOICE_STATUS
  REQUEST_STATUS
  SALARY_SLIP
  GENERAL
}

enum PayrollStatus {
  DRAFT
  APPROVED
  REJECTED
  TRANSFERRED
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ChatChannelType {
  GENERAL
  GROUP
  DIRECT
}

enum DocumentReviewStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── Core Tables ─────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees   Employee[]
  headId      String?    @map("head_id")

  @@map("departments")
}

model OfficeLocation {
  id            String   @id @default(uuid())
  name          String
  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)
  radiusMeters  Int      @default(200) @map("radius_meters")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("office_locations")
}

model Employee {
  id               String         @id @default(uuid())
  employeeCode     String         @unique @map("employee_code")
  email            String         @unique
  passwordHash     String         @map("password_hash")
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  phone            String?
  departmentId     String?        @map("department_id")
  designation      String?
  role             Role           @default(EMPLOYEE)
  managerId        String?        @map("manager_id")
  joiningDate      DateTime       @map("joining_date") @db.Date
  salaryGrade      String?        @map("salary_grade")
  grossSalary      Decimal?       @map("gross_salary") @db.Decimal(12, 2)
  bankAccountEnc   String?        @map("bank_account_enc")
  panEnc           String?        @map("pan_enc")
  aadhaarLast4     String?        @map("aadhaar_last4") @db.Char(4)
  profilePhotoUrl  String?        @map("profile_photo_url")
  faceEnrolled     Boolean                    @default(false) @map("face_enrolled")
  faceVector       Unsupported("vector(512)")? @map("face_vector")
  faceEmbedding    Json?                      @map("face_embedding")
  faceVectorS3Key  String?                    @map("face_vector_s3_key")
  faceModel        String?                    @map("face_model")
  faceEnrolledAt   DateTime?                  @map("face_enrolled_at") @db.Timestamptz
  status           EmployeeStatus @default(ACTIVE)
  address          String?
  emergencyContact String?        @map("emergency_contact")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  department       Department?       @relation(fields: [departmentId], references: [id])
  manager          Employee?         @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates     Employee[]        @relation("ManagerSubordinates")

  attendance             AttendanceRecord[]
  expensesClaimed        Expense[]          @relation("ExpenseClaimant")
  expensesL1Approved     Expense[]          @relation("ExpenseL1Approver")
  expensesFinanceApproved Expense[]         @relation("ExpenseFinanceApprover")
  invoicesSubmitted      Invoice[]          @relation("InvoiceSubmitter")
  invoicesApproved       Invoice[]          @relation("InvoiceApprover")
  leaveRequests          LeaveRequest[]     @relation("LeaveRequester")
  leavesApproved         LeaveRequest[]     @relation("LeaveApprover")
  leaveBalances          LeaveBalance[]
  employeeRequests       EmployeeRequest[]  @relation("RequestSubmitter")
  requestsReviewed       EmployeeRequest[]  @relation("RequestReviewer")
  salarySlips            SalarySlip[]       @relation("SlipEmployee")
  salarySlipsUploaded    SalarySlip[]       @relation("SlipUploader")
  salaryStructures       SalaryStructure[]  @relation("StructureEmployee")
  salaryStructuresApproved SalaryStructure[] @relation("StructureApprover")
  salarySlipsApproved    SalarySlip[]       @relation("SlipApprover")
  notifications          Notification[]
  commentsMade           Comment[]
  auditLogs              AuditLog[]         @relation("AuditActor")
  attendanceRegularized  AttendanceRecord[] @relation("AttendanceRegularizer")
  consentRecords         ConsentRecord[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  documents              EmployeeDocument[]
  tasksCreated           Task[]             @relation("TaskCreator")
  taskAssignments        TaskAssignment[]
  chatMemberships        ChatChannelMember[]
  chatMessages           ChatMessage[]
  policyAcknowledgements PolicyAcknowledgement[]
  lifecycleEvents        EmployeeLifecycleEvent[] @relation("LifecycleEmployee")
  lifecycleEventsCreated EmployeeLifecycleEvent[] @relation("LifecycleCreator")
  faceEmbeddingRecord    FaceEmbedding?

  // Company Intelligence relations
  companiesResponsible   ClientCompany[]          @relation("CompanyResponsible")
  companiesCreated       ClientCompany[]          @relation("CompanyCreator")
  companyProjects        CompanyProject[]         @relation("ProjectLead")
  statusHistoryChanges   CompanyStatusHistory[]   @relation("StatusHistoryChanger")
  companyVisits          CompanyVisit[]           @relation("VisitEmployee")
  meetingNotesEntered    MeetingNote[]            @relation("MeetingNoteEntered")
  meetingNotesReviewed   MeetingNote[]            @relation("MeetingNoteReviewer")
  workUpdatesSubmitted   WorkUpdate[]             @relation("WorkUpdateEmployee")
  workUpdatesReviewed    WorkUpdate[]             @relation("WorkUpdateReviewer")
  timelineEntries        CompanyTimelineEntry[]   @relation("TimelineEmployee")
  calendarEventsAssigned CalendarEvent[]          @relation("CalendarAssignee")
  calendarEventsCreated  CalendarEvent[]          @relation("CalendarCreator")
  alertsResolved         CompanyAlert[]           @relation("AlertResolver")
  attendanceEdits        AttendanceEditHistory[]  @relation("AttendanceEditor")

  @@map("employees")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  employeeId  String   @map("employee_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  isRevoked   Boolean  @default(false) @map("is_revoked")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AttendanceRecord {
  id                     String           @id @default(uuid())
  employeeId             String           @map("employee_id")
  date                   DateTime         @db.Date
  punchInTime            DateTime?        @map("punch_in_time") @db.Timestamptz
  punchOutTime           DateTime?        @map("punch_out_time") @db.Timestamptz
  punchInLat             Decimal?         @map("punch_in_lat") @db.Decimal(10, 7)
  punchInLng             Decimal?         @map("punch_in_lng") @db.Decimal(10, 7)
  punchOutLat            Decimal?         @map("punch_out_lat") @db.Decimal(10, 7)
  punchOutLng            Decimal?         @map("punch_out_lng") @db.Decimal(10, 7)
  status                 AttendanceStatus @default(PRESENT)
  workingHours           Decimal?         @map("working_hours") @db.Decimal(4, 2)
  isGeoValidIn           Boolean?         @map("is_geo_valid_in")
  isGeoValidOut          Boolean?         @map("is_geo_valid_out")
  frConfidenceIn         Decimal?         @map("fr_confidence_in") @db.Decimal(4, 3)
  frConfidenceOut        Decimal?         @map("fr_confidence_out") @db.Decimal(4, 3)
  isRegularized          Boolean          @default(false) @map("is_regularized")
  regularizedBy          String?          @map("regularized_by")
  regularizationReason   String?          @map("regularization_reason")
  isManualPunch          Boolean          @default(false) @map("is_manual_punch")
  manualPunchReason      String?          @map("manual_punch_reason")
  deviceInfo             Json?            @map("device_info")
  notes                  String?
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  employee    Employee                @relation(fields: [employeeId], references: [id])
  regularizer Employee?               @relation("AttendanceRegularizer", fields: [regularizedBy], references: [id])
  editHistory AttendanceEditHistory[]

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model Expense {
  id                  String        @id @default(uuid())
  employeeId          String        @map("employee_id")
  category            ExpenseCategory
  amount              Decimal       @db.Decimal(10, 2)
  expenseDate         DateTime      @map("expense_date") @db.Date
  description         String?
  paymentMode         PaymentMode?  @map("payment_mode")
  billS3Key           String?       @map("bill_s3_key")
  status              ExpenseStatus @default(DRAFT)
  l1ApproverId        String?       @map("l1_approver_id")
  l1ApprovedAt        DateTime?     @map("l1_approved_at") @db.Timestamptz
  financeApproverId   String?       @map("finance_approver_id")
  financeApprovedAt   DateTime?     @map("finance_approved_at") @db.Timestamptz
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz
  paymentRef          String?       @map("payment_ref")
  rejectionReason     String?       @map("rejection_reason")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  employee         Employee  @relation("ExpenseClaimant", fields: [employeeId], references: [id])
  l1Approver       Employee? @relation("ExpenseL1Approver", fields: [l1ApproverId], references: [id])
  financeApprover  Employee? @relation("ExpenseFinanceApprover", fields: [financeApproverId], references: [id])
  comments         Comment[]

  @@map("expenses")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  type          InvoiceType
  partyName     String        @map("party_name")
  amount        Decimal       @db.Decimal(12, 2)
  gstPercent    Decimal?      @map("gst_percent") @db.Decimal(4, 2)
  dueDate       DateTime      @map("due_date") @db.Date
  description   String?
  fileS3Key     String?       @map("file_s3_key")
  status        InvoiceStatus @default(PENDING)
  submittedBy   String        @map("submitted_by")
  approvedBy    String?       @map("approved_by")
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz
  paymentRef    String?       @map("payment_ref")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  submitter  Employee  @relation("InvoiceSubmitter", fields: [submittedBy], references: [id])
  approver   Employee? @relation("InvoiceApprover", fields: [approvedBy], references: [id])
  comments   Comment[]

  @@map("invoices")
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  leaveType   LeaveType @map("leave_type")
  totalDays   Int       @default(0) @map("total_days")
  usedDays    Int       @default(0) @map("used_days")
  year        Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  employee  Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, leaveType, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  employeeId   String      @map("employee_id")
  leaveType    LeaveType   @map("leave_type")
  fromDate     DateTime    @map("from_date") @db.Date
  toDate       DateTime    @map("to_date") @db.Date
  totalDays    Int         @map("total_days")
  reason       String
  status       LeaveStatus @default(PENDING)
  approvedBy   String?     @map("approved_by")
  approvedAt   DateTime?   @map("approved_at") @db.Timestamptz
  rejectionReason String?  @map("rejection_reason")
  documentS3Key   String?  @map("document_s3_key")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  employee  Employee  @relation("LeaveRequester", fields: [employeeId], references: [id])
  approver  Employee? @relation("LeaveApprover", fields: [approvedBy], references: [id])
  comments  Comment[]

  @@map("leave_requests")
}

model EmployeeRequest {
  id            String        @id @default(uuid())
  employeeId    String        @map("employee_id")
  requestType   RequestType   @map("request_type")
  details       Json
  status        RequestStatus @default(PENDING)
  reviewedBy    String?       @map("reviewed_by")
  reviewedAt    DateTime?     @map("reviewed_at") @db.Timestamptz
  comment       String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  employee  Employee  @relation("RequestSubmitter", fields: [employeeId], references: [id])
  reviewer  Employee? @relation("RequestReviewer", fields: [reviewedBy], references: [id])
  comments  Comment[]

  @@map("employee_requests")
}

model SalarySlip {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  month         Int
  year          Int
  baseSalary    Decimal? @map("base_salary") @db.Decimal(12, 2)
  incentives    Decimal  @default(0) @db.Decimal(12, 2)
  reimbursements Decimal @default(0) @db.Decimal(12, 2)
  grossSalary   Decimal  @map("gross_salary") @db.Decimal(12, 2)
  deductions    Decimal  @db.Decimal(12, 2)
  netPayable    Decimal  @map("net_payable") @db.Decimal(12, 2)
  lopDays       Int      @default(0) @map("lop_days")
  daysPresent   Int      @map("days_present")
  status        PayrollStatus @default(DRAFT)
  slipPdfS3Key  String?  @map("slip_pdf_s3_key")
  signatureName String?  @map("signature_name")
  signatureTitle String? @map("signature_title")
  signatureAssetKey String? @map("signature_asset_key")
  approvedBy    String?  @map("approved_by")
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz
  transferredAt DateTime? @map("transferred_at") @db.Timestamptz
  paymentRef    String?  @map("payment_ref")
  emailSentAt   DateTime? @map("email_sent_at") @db.Timestamptz
  notes         String?
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee  Employee @relation("SlipEmployee", fields: [employeeId], references: [id])
  uploader  Employee @relation("SlipUploader", fields: [uploadedBy], references: [id])
  approver  Employee? @relation("SlipApprover", fields: [approvedBy], references: [id])

  @@unique([employeeId, month, year])
  @@map("salary_slips")
}

model SalaryStructure {
  id              String   @id @default(uuid())
  employeeId      String   @map("employee_id")
  basic           Decimal  @db.Decimal(12, 2)
  hra             Decimal  @default(0) @db.Decimal(12, 2)
  allowances      Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction     Decimal  @default(0) @map("pf_deduction") @db.Decimal(12, 2)
  professionalTax Decimal  @default(0) @map("professional_tax") @db.Decimal(12, 2)
  tds             Decimal  @default(0) @db.Decimal(12, 2)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  approvedBy      String?  @map("approved_by")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz
  signatureName   String?  @map("signature_name")
  signatureTitle  String?  @map("signature_title")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee Employee @relation("StructureEmployee", fields: [employeeId], references: [id])
  approver Employee? @relation("StructureApprover", fields: [approvedBy], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId])
  @@map("salary_structures")
}

model Notification {
  id            String           @id @default(uuid())
  employeeId    String           @map("employee_id")
  type          NotificationType
  title         String
  body          String
  isRead        Boolean          @default(false) @map("is_read")
  referenceId   String?          @map("reference_id")
  referenceType String?          @map("reference_type")
  createdAt     DateTime         @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Comment {
  id            String   @id @default(uuid())
  authorId      String   @map("author_id")
  body          String
  attachmentS3Key String? @map("attachment_s3_key")

  expenseId     String?          @map("expense_id")
  invoiceId     String?          @map("invoice_id")
  leaveRequestId String?         @map("leave_request_id")
  employeeRequestId String?      @map("employee_request_id")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  author          Employee         @relation(fields: [authorId], references: [id])
  expense         Expense?         @relation(fields: [expenseId], references: [id])
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  leaveRequest    LeaveRequest?    @relation(fields: [leaveRequestId], references: [id])
  employeeRequest EmployeeRequest? @relation(fields: [employeeRequestId], references: [id])

  @@map("comments")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  actor  Employee @relation("AuditActor", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model ConsentRecord {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  consentType String   @map("consent_type")
  granted     Boolean
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id])

  @@map("consent_records")
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  docType      String   @map("doc_type")
  fileS3Key    String   @map("file_s3_key")
  uploadedBy   String   @map("uploaded_by")
  status       DocumentReviewStatus @default(PENDING)
  reviewedBy   String?  @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason String? @map("rejection_reason")
  expiresAt    DateTime? @map("expires_at") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_documents")
}

model CompanySetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  title       String
  description String?
  isPaid      Boolean  @default(true) @map("is_paid")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date, title])
  @@map("holidays")
}

model Policy {
  id        String       @id @default(uuid())
  title     String
  category  String
  body      String
  status    PolicyStatus @default(DRAFT)
  version   String       @default("1.0")
  createdBy String       @map("created_by")
  publishedAt DateTime?  @map("published_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  acknowledgements PolicyAcknowledgement[]

  @@map("policies")
}

model PolicyAcknowledgement {
  id         String   @id @default(uuid())
  policyId   String   @map("policy_id")
  employeeId String   @map("employee_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([policyId, employeeId])
  @@map("policy_acknowledgements")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueAt       DateTime? @map("due_at") @db.Timestamptz
  priority    String    @default("NORMAL")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator     Employee @relation("TaskCreator", fields: [createdBy], references: [id])
  assignments TaskAssignment[]

  @@map("tasks")
}

model TaskAssignment {
  id          String     @id @default(uuid())
  taskId      String     @map("task_id")
  employeeId  String     @map("employee_id")
  status      TaskStatus @default(OPEN)
  completedAt DateTime?  @map("completed_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at")

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@map("task_assignments")
}

model ChatChannel {
  id        String          @id @default(uuid())
  name      String
  type      ChatChannelType @default(GENERAL)
  createdBy String?         @map("created_by")
  createdAt DateTime        @default(now()) @map("created_at")

  messages ChatMessage[]
  members  ChatChannelMember[]

  @@map("chat_channels")
}

model ChatChannelMember {
  id          String    @id @default(uuid())
  channelId   String    @map("channel_id")
  employeeId  String    @map("employee_id")
  lastReadAt  DateTime? @map("last_read_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at")

  channel  ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([channelId, employeeId])
  @@map("chat_channel_members")
}

model ChatMessage {
  id        String   @id @default(uuid())
  channelId String   @map("channel_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  Employee    @relation(fields: [authorId], references: [id])

  @@index([channelId, createdAt])
  @@map("chat_messages")
}

model EmployeeLifecycleEvent {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  eventType   String   @map("event_type")
  title       String
  description String?
  status      String   @default("OPEN")
  dueAt       DateTime? @map("due_at") @db.Timestamptz
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee @relation("LifecycleEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  creator  Employee @relation("LifecycleCreator", fields: [createdBy], references: [id])

  @@map("employee_lifecycle_events")
}

model PasswordResetToken {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  otpHash      String    @map("otp_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  usedAt       DateTime? @map("used_at") @db.Timestamptz
  attemptCount Int       @default(0) @map("attempt_count")
  ipAddress    String    @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Company Intelligence Enums ───────────────────────────────────────────────

enum CompanyBusinessStatus {
  ACTIVE
  DELAYED
  AT_RISK
  LOST
  DORMANT
}

enum CompanyCriticality {
  HIGH
  MEDIUM
  LOW
}

enum TimelineEntryType {
  VISIT
  AUDIT_PREP
  DOCUMENT_REVIEW
  CLIENT_CALL
  INTERNAL_MEETING
  EMPLOYEE_UPDATE
  MEETING_NOTE
  PENDING_TASK
  COMPLETED_TASK
  AI_SUMMARY
  NEXT_ACTION
  STATUS_CHANGE
  ALERT
}

enum CalendarEventType {
  AUDIT
  CLIENT_VISIT
  INTERNAL_MEETING
  DOCUMENT_DEADLINE
  FOLLOW_UP
  TASK_DEADLINE
  OWNER_MEETING
  RECURRING_REVIEW
  AI_SUGGESTED
}

enum AlertSeverity {
  MILD
  MODERATE
  CRITICAL
}

enum WorkUpdateStatus {
  PENDING_REVIEW
  APPROVED
  NEEDS_CORRECTION
}

// ─── Client Company Models ────────────────────────────────────────────────────

model ClientCompany {
  id                    String                @id @default(uuid())
  name                  String
  shortName             String?               @map("short_name")
  industry              String?               @default("Pharma")
  contactEmail          String?               @map("contact_email")
  contactPhone          String?               @map("contact_phone")
  address               String?
  website               String?
  businessStatus        CompanyBusinessStatus @default(ACTIVE) @map("business_status")
  criticality           CompanyCriticality    @default(MEDIUM)
  currentStage          String?               @map("current_stage")
  responsibleEmployeeId String?               @map("responsible_employee_id")
  lastVisitDate         DateTime?             @map("last_visit_date") @db.Date
  lastCommunicationDate DateTime?             @map("last_communication_date") @db.Date
  nextAuditDate         DateTime?             @map("next_audit_date") @db.Date
  isArchived            Boolean               @default(false) @map("is_archived")
  archivedReason        String?               @map("archived_reason")
  notes                 String?
  riskScore             Int                   @default(0) @map("risk_score")
  createdBy             String                @map("created_by")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  responsibleEmployee Employee?              @relation("CompanyResponsible", fields: [responsibleEmployeeId], references: [id])
  creator             Employee               @relation("CompanyCreator", fields: [createdBy], references: [id])
  contacts            CompanyContact[]
  projects            CompanyProject[]
  statusHistory       CompanyStatusHistory[]
  visits              CompanyVisit[]
  meetingNotes        MeetingNote[]
  workUpdates         WorkUpdate[]
  timelineEntries     CompanyTimelineEntry[]
  calendarEvents      CalendarEvent[]
  aiSummaries         AISummary[]
  alerts              CompanyAlert[]

  @@index([businessStatus])
  @@index([criticality])
  @@index([lastVisitDate])
  @@map("client_companies")
}

model CompanyContact {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_contacts")
}

model CompanyProject {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  name           String
  description    String?
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  status         String    @default("ACTIVE")
  leadEmployeeId String?   @map("lead_employee_id")
  auditType      String?   @map("audit_type")
  auditBody      String?   @map("audit_body")
  auditDate      DateTime? @map("audit_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company      ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadEmployee Employee?     @relation("ProjectLead", fields: [leadEmployeeId], references: [id])

  @@map("company_projects")
}

model CompanyStatusHistory {
  id             String                @id @default(uuid())
  companyId      String                @map("company_id")
  businessStatus CompanyBusinessStatus @map("business_status")
  criticality    CompanyCriticality
  riskScore      Int                   @map("risk_score")
  summary        String?
  changedBy      String                @map("changed_by")
  createdAt      DateTime              @default(now()) @map("created_at")

  company           ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changedByEmployee Employee      @relation("StatusHistoryChanger", fields: [changedBy], references: [id])

  @@map("company_status_history")
}

model CompanyVisit {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  visitedBy    String    @map("visited_by")
  visitDate    DateTime  @map("visit_date") @db.Date
  purpose      String?
  outcome      String?
  nextSteps    String?
  followUpDate DateTime? @map("follow_up_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visitor Employee      @relation("VisitEmployee", fields: [visitedBy], references: [id])

  @@map("company_visits")
}

model MeetingNote {
  id               String    @id @default(uuid())
  companyId        String?   @map("company_id")
  enteredBy        String    @map("entered_by")
  rawText          String    @map("raw_text")
  meetingDate      DateTime  @map("meeting_date") @db.Date
  extractedData    Json?     @map("extracted_data")
  companyName      String?   @map("company_name")
  employeeName     String?   @map("employee_name")
  workDiscussed    String?   @map("work_discussed")
  assignedTo       String?   @map("assigned_to")
  deadline         DateTime? @map("deadline") @db.Date
  currentStatus    String?   @map("current_status")
  pendingGap       String?   @map("pending_gap")
  followUpAction   String?   @map("follow_up_action")
  priorityLevel    String?   @map("priority_level")
  ownerNote        String?   @map("owner_note")
  needsAdminReview Boolean   @default(false) @map("needs_admin_review")
  adminReviewedBy  String?   @map("admin_reviewed_by")
  adminReviewedAt  DateTime? @map("admin_reviewed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company           ClientCompany? @relation(fields: [companyId], references: [id])
  enteredByEmployee Employee       @relation("MeetingNoteEntered", fields: [enteredBy], references: [id])
  adminReviewer     Employee?      @relation("MeetingNoteReviewer", fields: [adminReviewedBy], references: [id])

  @@map("meeting_notes")
}

model WorkUpdate {
  id               String           @id @default(uuid())
  employeeId       String           @map("employee_id")
  companyId        String?          @map("company_id")
  rawText          String           @map("raw_text")
  updateDate       DateTime         @map("update_date") @db.Date
  extractedData    Json?            @map("extracted_data")
  companyName      String?          @map("company_name")
  taskCompleted    String?          @map("task_completed")
  pendingTask      String?          @map("pending_task")
  progress         String?
  contribution     String?
  workStatus       String?          @map("work_status")
  nextAction       String?          @map("next_action")
  status           WorkUpdateStatus @default(PENDING_REVIEW)
  needsAdminReview Boolean          @default(false) @map("needs_admin_review")
  reviewedBy       String?          @map("reviewed_by")
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  employee Employee       @relation("WorkUpdateEmployee", fields: [employeeId], references: [id])
  company  ClientCompany? @relation(fields: [companyId], references: [id])
  reviewer Employee?      @relation("WorkUpdateReviewer", fields: [reviewedBy], references: [id])

  @@map("work_updates")
}

model CompanyTimelineEntry {
  id            String            @id @default(uuid())
  companyId     String            @map("company_id")
  entryType     TimelineEntryType @map("entry_type")
  title         String
  description   String?
  employeeId    String?           @map("employee_id")
  referenceId   String?           @map("reference_id")
  referenceType String?           @map("reference_type")
  entryDate     DateTime          @map("entry_date") @db.Timestamptz
  createdAt     DateTime          @default(now()) @map("created_at")

  company  ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee?     @relation("TimelineEmployee", fields: [employeeId], references: [id])

  @@index([companyId, entryDate])
  @@map("company_timeline_entries")
}

model CalendarEvent {
  id            String            @id @default(uuid())
  title         String
  description   String?
  eventType     CalendarEventType @map("event_type")
  startDate     DateTime          @map("start_date") @db.Timestamptz
  endDate       DateTime?         @map("end_date") @db.Timestamptz
  allDay        Boolean           @default(false) @map("all_day")
  companyId     String?           @map("company_id")
  assignedTo    String?           @map("assigned_to")
  createdBy     String            @map("created_by")
  isRecurring   Boolean           @default(false) @map("is_recurring")
  recurringRule String?           @map("recurring_rule")
  reminderDays  Int?              @map("reminder_days")
  isAiSuggested Boolean           @default(false) @map("is_ai_suggested")
  zohoEventId   String?           @map("zoho_event_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  company  ClientCompany? @relation(fields: [companyId], references: [id])
  assignee Employee?      @relation("CalendarAssignee", fields: [assignedTo], references: [id])
  creator  Employee       @relation("CalendarCreator", fields: [createdBy], references: [id])

  @@index([startDate])
  @@index([companyId])
  @@map("calendar_events")
}

model AISummary {
  id          String    @id @default(uuid())
  companyId   String?   @map("company_id")
  summaryType String    @map("summary_type")
  content     String
  metadata    Json?
  generatedAt DateTime  @default(now()) @map("generated_at")
  expiresAt   DateTime? @map("expires_at")

  company ClientCompany? @relation(fields: [companyId], references: [id])

  @@index([companyId, summaryType])
  @@map("ai_summaries")
}

model CompanyAlert {
  id         String        @id @default(uuid())
  companyId  String        @map("company_id")
  severity   AlertSeverity
  alertType  String        @map("alert_type")
  message    String
  isResolved Boolean       @default(false) @map("is_resolved")
  resolvedBy String?       @map("resolved_by")
  resolvedAt DateTime?     @map("resolved_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at")

  company  ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resolver Employee?     @relation("AlertResolver", fields: [resolvedBy], references: [id])

  @@index([companyId, isResolved])
  @@map("company_alerts")
}

model AttendanceEditHistory {
  id           String   @id @default(uuid())
  attendanceId String   @map("attendance_id")
  editedBy     String   @map("edited_by")
  fieldChanged String   @map("field_changed")
  originalValue String? @map("original_value")
  newValue     String?  @map("new_value")
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  editor     Employee         @relation("AttendanceEditor", fields: [editedBy], references: [id])

  @@map("attendance_edit_history")
}

// ── Face Recognition ─────────────────────────────────────────────────────────

model FaceEmbedding {
  id         String                     @id @default(uuid())
  employeeId String                     @unique @map("employee_id")
  /// 512-dimensional DeepFace/Facenet512 embedding stored as pgvector
  embedding  Unsupported("vector(512)")
  createdAt  DateTime                   @default(now()) @map("created_at")
  updatedAt  DateTime                   @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("face_embeddings")
}
