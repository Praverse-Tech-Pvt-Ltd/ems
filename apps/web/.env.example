# NexGen EMS web environment example.
# Do not put backend secrets here. NEXT_PUBLIC_ variables are visible in the browser.
#
# Replace this after Render gives you the backend API URL.
# No trailing /api/v1. The frontend code appends /api/v1 itself.
NEXT_PUBLIC_API_URL=https://<your-render-api-service>.onrender.com
NEXT_PUBLIC_DEV_BYPASS=false
