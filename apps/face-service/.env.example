# ── Neon DB (direct URL — no pgbouncer) ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.region.neon.tech/dbname?sslmode=require

# ── Face Recognition ─────────────────────────────────────────────────────────
# Cosine similarity threshold (0–1); lower = stricter matching
RECOGNITION_THRESHOLD=0.5
