# ── Neon DB ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host-pooler.region.neon.tech/dbname?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@host.region.neon.tech/dbname?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local: redis://localhost:6380
# Upstash: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption ────────────────────────────────────────────────────────────────
# Must be exactly 32 chars for AES-256
ENCRYPTION_KEY=your_32_char_encryption_key_here

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
# S3-compatible (required when STORAGE_DRIVER=s3)
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexgen-ems-dev
AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# ── Face Recognition ──────────────────────────────────────────────────────────
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_API_KEY=replace_with_internal_face_service_token
RECOGNITION_THRESHOLD=0.6

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=NexGen Pharma EMS

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
BCRYPT_OTP_ROUNDS=8

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_WINDOW=1800

# ── Cron Schedules ────────────────────────────────────────────────────────────
CRON_TOKEN_CLEANUP=0 2 * * *

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Geo-fence ─────────────────────────────────────────────────────────────────
OFFICE_LAT=28.6139
OFFICE_LNG=77.2090
OFFICE_RADIUS_METERS=200
