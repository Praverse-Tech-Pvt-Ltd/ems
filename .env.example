# NexGen EMS environment example
#
# Keep backend secrets only in the API project. Only variables prefixed with
# NEXT_PUBLIC_ belong in the web project because they are exposed to browsers.
#
# Face recognition service variables have been removed.

# ---------------------------------------------------------------------------
# Database - API project
# ---------------------------------------------------------------------------
# Use the Neon pooled connection for runtime.
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.neon.tech/<dbname>?sslmode=require&pgbouncer=true

# Use the Neon direct connection for Prisma CLI/generate/migrations.
DIRECT_URL=postgresql://<user>:<password>@<host>.<region>.neon.tech/<dbname>?sslmode=require

# ---------------------------------------------------------------------------
# Redis / queues - API project
# ---------------------------------------------------------------------------
# Required at API startup. For Vercel, use an external Redis such as Upstash.
# Local Docker example: redis://localhost:6380
# Upstash example: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ---------------------------------------------------------------------------
# Auth / security - API project
# ---------------------------------------------------------------------------
# Generate secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_REFRESH_SECRET=replace_with_a_different_64_byte_random_hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Must be exactly 32 characters. Generate:
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_32_char_random_hex

BCRYPT_ROUNDS=12
BCRYPT_OTP_ROUNDS=8
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_WINDOW=1800

# ---------------------------------------------------------------------------
# CORS / app URLs - API project
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://ems.nexgenpharmasolutions.com

# Comma-separated. Include the custom domain and the Vercel web deployment URL.
CORS_ALLOWED_ORIGINS=https://ems.nexgenpharmasolutions.com,https://<your-web-project>.vercel.app

# ---------------------------------------------------------------------------
# Email - API project
# ---------------------------------------------------------------------------
# Required at API startup by EmailService.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@nexgenpharmasolutions.com
RESEND_FROM_NAME=NexGen Pharma EMS

# ---------------------------------------------------------------------------
# File storage - API project
# ---------------------------------------------------------------------------
# Recommended for production on Vercel: s3-compatible object storage
# such as AWS S3 or Cloudflare R2. Local storage on Vercel is ephemeral.
STORAGE_DRIVER=s3
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexgen-ems-prod
AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# For local development only:
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=uploads

# ---------------------------------------------------------------------------
# Geo-fence - API project
# ---------------------------------------------------------------------------
OFFICE_LAT=28.6139
OFFICE_LNG=77.2090
OFFICE_RADIUS_METERS=200

# ---------------------------------------------------------------------------
# AI / owner configuration - API project
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OWNER_EMPLOYEE_IDS=f2112547-5be0-4819-9d66-13996dc56581,b300bd45-0e53-41e6-a9bc-448f4c4dcd40
AI_CHAT_ENABLED=true

ALERT_MILD_DAYS=7
ALERT_MODERATE_DAYS=15
ALERT_CRITICAL_DAYS=30
ALERT_VISIT_DAYS=45
FOLLOWUP_THRESHOLD_MILD=7
FOLLOWUP_THRESHOLD_MODERATE=15
FOLLOWUP_THRESHOLD_CRITICAL=30

# Optional / future integrations.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_REFRESH_TOKEN=
WHATSAPP_API_KEY=

# ---------------------------------------------------------------------------
# Frontend - web project
# ---------------------------------------------------------------------------
# No trailing /api/v1. The frontend code appends /api/v1 itself.
NEXT_PUBLIC_API_URL=https://ems-api-neon.vercel.app
NEXT_PUBLIC_DEV_BYPASS=false
