# ── Neon DB ───────────────────────────────────────────────────────────────────
# Pooled (pgbouncer) — used by apps/api at runtime
# Get from: Neon dashboard → Project → Connection Details → Pooled connection
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.neon.tech/<dbname>?sslmode=require&pgbouncer=true
# Direct — used by Prisma CLI for migrations (packages/db)
DIRECT_URL=postgresql://<user>:<password>@<host>.<region>.neon.tech/<dbname>?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker:  redis://localhost:6380
# Upstash (free tier: upstash.com): rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6380

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption ────────────────────────────────────────────────────────────────
# Must be exactly 32 chars for AES-256
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=change_this_32_char_encryption_key!!

# ── Storage ───────────────────────────────────────────────────────────────────
# local: stores files on disk under LOCAL_STORAGE_DIR
# s3:    uses AWS S3 / Cloudflare R2 / Backblaze B2
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
# S3-compatible (required when STORAGE_DRIVER=s3)
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexgen-ems-dev
AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get API key from: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=NexGen Pharma EMS

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
BCRYPT_OTP_ROUNDS=8

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_WINDOW=1800

# ── Cron Schedules (cron syntax) ──────────────────────────────────────────────
CRON_TOKEN_CLEANUP=0 2 * * *

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Geo-fence ─────────────────────────────────────────────────────────────────
OFFICE_LAT=28.6139
OFFICE_LNG=77.2090
OFFICE_RADIUS_METERS=200

# ── Gemini AI (Google) ────────────────────────────────────────────────────────
# Get from: aistudio.google.com → API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Owner Access (comma-separated employee IDs) ───────────────────────────────
# Ashwani Shrivastav: f2112547-5be0-4819-9d66-13996dc56581
# Pratham Shrivastav: b300bd45-0e53-41e6-a9bc-448f4c4dcd40
OWNER_EMPLOYEE_IDS=f2112547-5be0-4819-9d66-13996dc56581,b300bd45-0e53-41e6-a9bc-448f4c4dcd40

# ── Company Intelligence alert thresholds (days) ──────────────────────────────
ALERT_MILD_DAYS=7
ALERT_MODERATE_DAYS=15
ALERT_CRITICAL_DAYS=30
ALERT_VISIT_DAYS=45

# ── Follow-up task auto-generation thresholds ─────────────────────────────────
FOLLOWUP_THRESHOLD_MILD=7
FOLLOWUP_THRESHOLD_MODERATE=15
FOLLOWUP_THRESHOLD_CRITICAL=30

# ── AI Chat ───────────────────────────────────────────────────────────────────
AI_CHAT_ENABLED=true

# ── Zoho Integration (TIER 3 — not built yet) ────────────────────────────────
# See apps/api/src/modules/zoho-sync/zoho-sync.module.ts
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_REFRESH_TOKEN=
# WhatsApp (TIER 3)
WHATSAPP_API_KEY=
