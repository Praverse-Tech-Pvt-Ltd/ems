# ── Neon DB ───────────────────────────────────────────────────────────────────
# Pooled (pgbouncer) — used by apps/api at runtime
# Get from: Neon dashboard → Project → Connection Details → Pooled connection
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.neon.tech/<dbname>?sslmode=require&pgbouncer=true
# Direct — used by Prisma CLI for migrations (packages/db)
DIRECT_URL=postgresql://<user>:<password>@<host>.<region>.neon.tech/<dbname>?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker:  redis://localhost:6380
# Upstash (free tier: upstash.com): rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6380

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption ────────────────────────────────────────────────────────────────
# Must be exactly 32 chars for AES-256
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=change_this_32_char_encryption_key!!

# ── Storage ───────────────────────────────────────────────────────────────────
# local: stores files on disk under LOCAL_STORAGE_DIR
# s3:    uses AWS S3 / Cloudflare R2 / Backblaze B2
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
# S3-compatible (required when STORAGE_DRIVER=s3)
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexgen-ems-dev
AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# ── Face Recognition (dlib + pgvector, self-hosted) ───────────────────────────
# URL of the Python face-service (apps/face-service)
FACE_SERVICE_URL=http://localhost:8000
# Cosine similarity threshold (0–1); lower = stricter matching
RECOGNITION_THRESHOLD=0.5

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get API key from: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=NexGen Pharma EMS

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
BCRYPT_OTP_ROUNDS=8

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_WINDOW=1800

# ── Cron Schedules (cron syntax) ──────────────────────────────────────────────
CRON_TOKEN_CLEANUP=0 2 * * *

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Geo-fence ─────────────────────────────────────────────────────────────────
OFFICE_LAT=28.6139
OFFICE_LNG=77.2090
OFFICE_RADIUS_METERS=200
