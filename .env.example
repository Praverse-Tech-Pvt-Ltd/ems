# ── Neon DB (free tier: neon.tech) ────────────────────────────────────────────
# Pooled (pgbouncer) — used by apps/api at runtime
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&pgbouncer=true
# Direct — used by Prisma CLI for migrations (packages/db)
DIRECT_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local Docker:  redis://localhost:6380
# Upstash (free tier: upstash.com): rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6380

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption ────────────────────────────────────────────────────────────────
# Must be exactly 32 chars for AES-256
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=change_this_32_char_encryption_key!!

# ── Storage (S3-compatible) ───────────────────────────────────────────────────
# AWS S3:          leave AWS_ENDPOINT_URL empty, set region to e.g. ap-south-1
# Cloudflare R2:   AWS_REGION=auto, AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Backblaze B2:    AWS_REGION=us-west-004, AWS_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexgen-ems-dev
AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# ── Face Recognition ──────────────────────────────────────────────────────────
# Self-hosted DeepFace (free, no external API)
FR_SERVICE_URL=http://localhost:8000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Brevo (free 300/day):  SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
# Gmail:                 SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS=app-password
# Mailgun:               SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587
SES_FROM_EMAIL=noreply@yourdomain.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key

# ── Push Notifications (Firebase FCM — free) ──────────────────────────────────
# Get from Firebase Console > Project Settings > Cloud Messaging
FCM_SERVER_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Geo-fence ─────────────────────────────────────────────────────────────────
OFFICE_LAT=28.6139
OFFICE_LNG=77.2090
OFFICE_RADIUS_METERS=200
